{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!public",
      "!test-results",
      "!playwright-report",
      "!yarn.lock",
      "!next-env.d.ts"
    ]
  },
  // Formatter reproduces the former src/prettier.config.js exactly
  // (mapping researched + locked in prs/PR-002-tooling-hygiene.md).
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "css": {
    // Tailwind v4 at-rules (@theme, @custom-variant) in global.css
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
